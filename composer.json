{
  "name": "biigle/laravel-azure-storage",
  "description": "Azure Storage Blob filesystem driver for Laravel",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AzureOss\\Storage\\BlobLaravel\\": ""
    }
  },
  "authors": [
    {
      "name": "Brecht Vermeersch",
      "email": "brechtvermeersch@outlook.be"
    },
    {
      "name": "Martin Zurowietz",
      "email": "m.zurowietz@uni-bielefeld.de"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/filesystem": "^10|^11|^12|^13",
    "illuminate/support": "^10|^11|^12|^13",
    "azure-oss/storage-blob-flysystem": "^2.2"
  },
  "replace": {
    "azure-oss/storage-blob-laravel": "*"
  },
  "extra": {
    "laravel": {
      "providers": [
        "AzureOss\\Storage\\BlobLaravel\\AzureStorageBlobServiceProvider"
      ]
    }
  }
}
